{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn"],
  "jsPlugins": ["@tanstack/eslint-plugin-router"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "@tanstack/router/create-route-property-order": "warn",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unsafe-call": "warn",
    "typescript/no-unsafe-member-access": "warn",
    "typescript/no-unsafe-return": "warn",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-type-assertion": "warn",
    // oxlint 1.82 takes what useFloating returns for refs, so floating-ui's
    // `ref={refs.setFloating}` (a callback setter, not a `.current` read) counts
    // as a ref read during render, however it is named or hoisted.  Those sites
    // carry an oxlint-disable-next-line saying so.
    "react/refs": "warn",
    "react/react-in-jsx-scope": "off",
    // Names imposed by GraphQL and TanStack Router.
    "eslint/no-underscore-dangle": ["warn", { "allow": ["__typename", "_splat"] }]
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "ignorePatterns": ["src/__generated__/**", "src/routeTree.gen.ts", ".storybook/**"],
  "overrides": [
    {
      "files": ["**/*.stories.tsx"],
      "jsPlugins": ["eslint-plugin-storybook"],
      "rules": {
        "storybook/await-interactions": "error",
        "storybook/context-in-play-function": "error",
        "storybook/csf-component": "warn",
        "storybook/default-exports": "error",
        "storybook/hierarchy-separator": "error",
        "storybook/no-redundant-story-name": "warn",
        "storybook/no-renderer-packages": "error",
        "storybook/no-stories-of": "error",
        "storybook/no-title-property-in-meta": "warn",
        "storybook/prefer-pascal-case": "warn",
        "storybook/story-exports": "error",
        "storybook/use-storybook-expect": "error",
        "storybook/use-storybook-testing-library": "error"
      }
    },
    {
      // Test helpers are kept next to the tests that use them.
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
